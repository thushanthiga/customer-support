OPENAI_API_KEY=your_openai_api_key_here
CHAT_MODEL=gpt-6-luna

# Set these to the database accessible from the deployment server.
MYSQL_HOST=your_database_host
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_ROOT_DB=apptimate_v5_root
DEFAULT_TENANT_ID=your_registered_tenant_id
ALLOW_DEFAULT_TENANT=false
EMBEDDING_MODEL=text-embedding-3-small

# Production Django settings. Supply a persistent secret key.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace_with_a_generated_secret_key
DJANGO_ALLOWED_HOSTS=assistant.example.com,127.0.0.1,localhost

# Calendar dates for local analytics; configure for the deployment.
SUPPORT_TIME_ZONE=Asia/Colombo

# Planning uses JSON output, not function tools. Tune reasoning for your configured model.
QUERY_REASONING_EFFORT=medium
REVIEW_REASONING_EFFORT=low

# Use GPT-6 Luna planning with the configured database and ERP sign-in.
SUPPORT_BUSINESS_ENGINE=true
# Every signed-in assistant user can query all business modules.
SUPPORT_ANALYTICS_ACCESS=admin
# Absolute path to the Laravel ERP app on the server; empty uses apps/api
# under the monorepo root.
SUPPORT_ERP_ROOT=
PHP_BINARY=php
# Offline verification only. This disables model calls without substituting a model.
SUPPORT_DISABLE_MODEL_CALLS=false
SUPPORT_QA_PASSWORD=
